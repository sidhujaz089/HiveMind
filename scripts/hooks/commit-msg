#!/bin/sh
#
# commit-msg — enforces the message format and the Agent trailer.
#
# The trailer is the load-bearing part. Four AI tools and a person share this
# repository; without an attribution line, git log cannot tell you who to ask when
# something goes wrong, and scripts/audit-compliance.ps1 cannot attribute a finding
# to anyone. See AGENTS.md, "During a session".

MSG_FILE="$1"

# Strip comment lines so git's own template does not count as content.
BODY=$(grep -v '^#' "$MSG_FILE")
SUBJECT=$(echo "$BODY" | sed '/^[[:space:]]*$/d' | head -1)

fail() {
    echo ""
    echo "  COMMIT MESSAGE REJECTED — $1"
    echo ""
    echo "  Required shape:"
    echo ""
    echo "    <type>(<project>): <imperative summary>"
    echo ""
    echo "    <optional body>"
    echo ""
    echo "    Agent: <tool>/<model>"
    echo ""
    echo "  types    feat fix docs refactor test chore migrate session"
    echo "  project  a folder under projects/, or 'workspace' for repo-wide work"
    echo "  Agent    claude-code/opus-5 · codex/gpt-5 · gemini-cli/gemini-3-pro"
    echo "           ollama/qwen3-coder-30b · human/jas"
    echo ""
    echo "  Your message is preserved. Edit and retry."
    echo ""
    exit 1
}

# THE ROLE GATE RUNS FIRST, BEFORE THE MERGE EXEMPTION BELOW (t476). A merge into main is
# refused unless the Agent trailer's role has merge_review in ROLES.json; before this, every
# "Merge ..." subject exited 0 here and the DeepSeek Harness's empty task list bound nothing.
TOP=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$TOP" ] && [ -f "$TOP/scripts/role_gate.py" ]; then
    python3 "$TOP/scripts/role_gate.py" commit-msg "$MSG_FILE" || exit 1
fi

# Merges and reverts are generated by git; do not hold them to the format.
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

if [ -z "$SUBJECT" ]; then
    fail "the message is empty."
fi

# --- A code commit does not sweep in run records (t452, 2026-10-01) ----------------------------
# Here, not in pre-commit, because the two legitimate carriers are known by their subject.
# Skipped when the helper is absent, as role_gate is: fixture repos copy this hook alone.
if [ -f "$(dirname "$0")/record_sweep.py" ]; then
    python3 "$(dirname "$0")/record_sweep.py" "$MSG_FILE" || exit 1
fi

# --- Subject line -----------------------------------------------------------------
if ! echo "$SUBJECT" | grep -qE '^(feat|fix|docs|refactor|test|chore|migrate|session)(\([a-z0-9._-]+\))?: .+'; then
    fail "the subject line does not match <type>(<project>): <summary>."
fi

# NO SUBJECT-LENGTH LIMIT. There was one, at 72 characters, removed 2026-09-22 on Jas's
# instruction: "Remove this limit if it serves no purpose. Let me know what the purpose is
# if there is one." It was searched for and there is none. It appeared in no contract
# document, no lesson and no check; git accepts arbitrarily long subjects; and no
# width-constrained reader was found that needed it -- not the plan board, not the phone
# notifications, and not `git log --oneline`, whose only two callers here count commits
# rather than rendering them. The likely origin is the 72-column email convention, adopted
# unexamined.
#
# Its one downstream consumer was a COST, not a justification: workspace_mcp/core.py grew a
# _subject() whose entire job was shortening generated paths to fit, after Chat hit the limit
# on an ordinary dated filename (2026-09-14). Q4 recorded it firing twice in one session as
# real rework (F11); it then fired five more times on 2026-09-22, every one a re-edit of a
# message whose content nobody disputed. A rule with no stated reason costs a round trip
# every time it fires, and the repository's own standard is that a check states why it
# exists -- so the honest options were to record the reason or to delete it.

# --- Agent trailer ----------------------------------------------------------------
# The model half may contain a colon: ollama tags are `name:tag`, and
# `qwen3.8:27b-mtp-q4_K_M` is the real identifier of the model that wrote the commit. Without
# it the charset could not express a valid value, so coder.py's review-branch commit was
# refused for every local run and the branch was never written -- the harness could not
# record WHICH local model produced a patch. Widened deliberately and narrowly: a colon is
# added to the model half only, and the shape <tool>/<model> is unchanged.
if ! echo "$BODY" | grep -qE '^Agent: [A-Za-z0-9._-]+/[A-Za-z0-9._:-]+[[:space:]]*$'; then
    fail "there is no valid 'Agent: <tool>/<model>' trailer."
fi

# --- Lane trailer (2026-10-26, four-lane plan, workspace/Claude and DeepSeek/) ------------------
# The Agent trailer names the MODEL, and two lanes share each model, so it cannot say which lane
# committed. A lane commit carries `Lane: L1`..`L4`; the claim check reads it. Optional, because the
# services and Jas commit too -- but when present it must be a real lane, never a guess.
if echo "$BODY" | grep -qE '^Lane:'; then
    # ONE RULE, ONE PLACE (mf3). The shape and the 24-character cap live in role_gate.LANE_RE
    # alone; this hook once carried its own grep copy, and the two disagreed on the cap. The
    # presence test above is only routing -- the FORM is role_gate's check-lane.
    if [ -n "$TOP" ] && [ -f "$TOP/scripts/role_gate.py" ]; then
        python3 "$TOP/scripts/role_gate.py" check-lane "$MSG_FILE" || exit 1
    fi
    # --- Another lane's file (commit B, 2026-10-27) ------------------------------------------
    # The shape above is the trailer's FORM; this is its meaning. A lane that names itself may not
    # commit into a file another lane owns (lanes.<Lx>.owns in ROLES.json) or that another lane
    # holds an unexpired claim on (scripts/lanes.py, read at its ABSOLUTE board path so all four
    # worktrees see one board). The rule lives in role_gate.check_lane -- ONE copy -- and runs here
    # rather than in pre-commit because git assembles the message AFTER that hook, so pre-commit
    # cannot see a trailer at all. Both refuse before any commit object exists.
    if [ -n "$TOP" ] && [ -f "$TOP/scripts/role_gate.py" ]; then
        python3 "$TOP/scripts/role_gate.py" lane-owns "$MSG_FILE" || exit 1
    fi
fi

exit 0
