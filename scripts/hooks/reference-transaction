#!/bin/sh
#
# reference-transaction -- the one place a FAST-FORWARD of main can be seen (t476).
#
# A fast-forward makes no commit, so commit-msg never runs and the role gate never reads a
# trailer. This hook sees every ref update; role_gate.py refuses only main moving onto the tip
# of a coder/* branch, and returns at once for anything else. See scripts/role_gate.py.
[ "$1" = "prepared" ] || exit 0
input=$(cat)
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
# Phase 0a: no switch / detach / stash in the live checkout. Before the main-only filter below,
# because a switch never names refs/heads/main.
case "$input" in
    *" HEAD"*|*" refs/stash"*)
        if [ -f "$top/scripts/hooks/live_repo_guard.py" ]; then
            printf '%s\n' "$input" | python3 "$top/scripts/hooks/live_repo_guard.py" ref-update || exit 1
        fi ;;
esac
case "$input" in
    *" refs/heads/main"*) ;;
    *) exit 0 ;;
esac
[ -f "$top/scripts/role_gate.py" ] || exit 0
printf '%s\n' "$input" | python3 "$top/scripts/role_gate.py" ref-update
