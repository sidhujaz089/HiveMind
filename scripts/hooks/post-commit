#!/bin/sh
# post-commit -- hand the auditor model every registered script this commit added or changed.
#
# Jas, 2026-09-14: Gemma audits "as needed when new registration requests are sent in ... in its
# priority queue and interrupt production", not on an hourly timer. Registration already files a
# review request; this files one for EDITS, which never go back through registration -- the case
# an hourly sweep was quietly covering. The scheduler runs each request as priority work.
# If the checks themselves changed, re-audit so every script is measured against the new rule.
# Never fails the commit: it has already happened.
cd "$(git rev-parse --show-toplevel)" || exit 0
files=$(git diff-tree --no-commit-id --name-only -r HEAD --diff-filter=AMR | grep -E '\.(py|sh)$')
[ -n "$files" ] && python3 scripts/library.py request-review $files >/dev/null 2>&1
echo "$files" | grep -qx 'scripts/library_checks.py' && python3 scripts/library.py audit >/dev/null 2>&1
# The Corpus tab's Scripts list: refresh descriptions for what this commit changed, in the
# background (the auditor model takes a few seconds per script) and never twice at once.
# NOT WHILE THE SCHEDULER IS PAUSED (2026-10-06). This launched the auditor model straight after
# a commit while the box was paused for Swift's bring-up, reloaded Q4 (17.5 GB) beside a 95 GB
# vLLM engine, and left 4 GB free. A pause that covers the scheduler but not its side doors is
# not a pause. The refresh is not lost: the next commit after resume picks up every change.
[ -f workspace/run-logs/scheduler-paused.enabled ] && exit 0
[ -n "$files" ] && (flock -n /tmp/corpus_scripts.lock python3 scripts/corpus_scripts.py >/dev/null 2>&1 &)
exit 0
