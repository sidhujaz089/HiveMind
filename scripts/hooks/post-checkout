#!/bin/bash
# KEEP chat/ OUT OF EVERY LINKED WORKTREE (2026-10-13, Jas: "Put chat/ in git").
#
# chat/ is tracked now -- the GitHub remote that kept it out (D-22) is gone -- but it is the family
# corpus and 140 MB. Every build, bridge, merge-gate and sandbox worktree the line creates
# (`git worktree add`, nine scripts) would otherwise check all of it out: a local model's file tools
# could read family material, and each worktree would cost 140 MB. One hook covers all nine, and any
# tenth, because git runs post-checkout after `git worktree add`.
#
# The main checkout is untouched (git-dir == common-dir). A worktree that genuinely needs chat/ can
# run `git sparse-checkout disable`.
if [ "$3" = "0" ]; then                                     # a path checkout: warn if it hit the live repo
    top=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f "$top/scripts/hooks/live_repo_guard.py" ] \
        && python3 "$top/scripts/hooks/live_repo_guard.py" path-checkout
    exit 0
fi
# Phase 0a: a branch checkout in the LIVE checkout is switched back to main (live_repo_guard.py).
top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$top" ] && [ -f "$top/scripts/hooks/live_repo_guard.py" ]; then
    python3 "$top/scripts/hooks/live_repo_guard.py" branch-checkout || exit 1
fi
gd=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
cd_=$(cd "$(git rev-parse --git-common-dir)" && pwd)
[ "$gd" = "$cd_" ] && exit 0                               # the main checkout keeps chat/
[ -n "$(git ls-files -- chat/ | head -1)" ] || exit 0      # nothing of chat/ tracked on this commit
if [ "$(git config --worktree --get core.sparseCheckout 2>/dev/null)" != "true" ]; then
    git sparse-checkout set --no-cone '/*' '!/chat/' >/dev/null 2>&1 \
        || echo "post-checkout: could not exclude chat/ from this worktree -- it is checked out here" >&2
fi
exit 0
