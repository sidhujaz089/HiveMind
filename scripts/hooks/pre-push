#!/bin/sh
#
# pre-push — the last gate before history leaves this machine.
#
# Runs the full invariant check. If a document and the disk disagree, the push
# stops here. Pushing is the moment drift becomes someone else's problem, so it is
# the right place to be strict.
#
# Set SKIP_WORKSPACE_CHECK=1 to bypass in a genuine emergency. That is visible in
# the shell history and honest, which --no-verify is not.

if [ "$SKIP_WORKSPACE_CHECK" = "1" ]; then
    echo "pre-push: SKIPPED by SKIP_WORKSPACE_CHECK=1"
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
CHECK="$REPO_ROOT/scripts/check_workspace.py"
TESTS="$REPO_ROOT/scripts/run_tests.py"

if [ ! -f "$CHECK" ]; then
    echo "pre-push: $CHECK not found — cannot verify. Refusing to push."
    exit 1
fi

# Python 3, not PowerShell. The workspace moved to Linux/aarch64 in 2026-08; the
# protocol scripts were ported and pwsh is not installed here. The old hook looked
# for pwsh, failed to find it, and refused every push — correct fail-closed
# behaviour, and the reason this hook changed rather than the check being skipped.
#
# python3 is required, not optional: a missing interpreter means the invariants
# were not checked, and "not checked" must never read as "clean". Refuse instead.
if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "pre-push: no Python 3 found — cannot verify. Refusing to push."
    exit 1
fi

echo "pre-push: running workspace check..."
"$PY" "$CHECK"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "  PUSH BLOCKED — the workspace check failed."
    echo ""
    echo "  A failure means a document and the disk disagree. Fix one of them."
    echo "  Do not edit the check to make this go away (AGENTS.md, rule 10)."
    echo ""
    exit 1
fi

# THE SUITES, BECAUSE THE THING THAT RUNS EVERY OTHER GUARD WAS ITSELF UNGUARDED.
# Added 2026-09-03 after Q4 audited the enforcement claims and named this the weakest link:
# "the only mechanism that runs them all is a script that is itself never automatically
# invoked... every other claim is conditional on a human remembering to run a script, which is
# the exact failure mode the repository's own docstrings condemn."
#
# session_end.py runs it too, but a session can end without session_end. A push cannot happen
# without this. run_tests.py honours workspace/test-failures-ceiling.json, so the three known
# failures do not block a push and a NEW one does.
#
# AND IT REUSES A SWEEP THAT ALREADY PASSED ON THIS EXACT TREE (2026-09-16).
# git opens the connection to the remote BEFORE it runs this hook. So the 16 minutes this
# sweep takes were 16 minutes of an idle SSH session, and GitHub closed it every time:
# "Connection to github.com closed by remote host", then git died of SIGPIPE with 33 commits
# still local. Measured the same day: the identical push with this hook skipped completes in
# 2.2 seconds. The tests were never the problem and the network was never the problem -- the
# DURATION was, and session_end had just run this same sweep minutes earlier over the same
# tree.
#
# --assert-fresh answers a question and runs nothing. It is satisfied only by a COMPLETE,
# clean, unfiltered sweep of a working tree whose content hashes identically to this one, and
# only within the window. Any byte different anywhere and it runs in full. This is not a way
# to skip the gate; it is a way to stop asking the same question twice in ten minutes.
if [ -f "$TESTS" ] && "$PY" "$TESTS" --assert-fresh 90; then
    echo "pre-push: the suites are already green for this exact tree (see above)."
elif [ -f "$TESTS" ]; then
    echo "pre-push: running the test suites..."
    # --resume so a sweep killed part-way does not start again from zero. Only passes
    # recorded against this same tree are reused, and each one is named in the report.
    rc=0
    "$PY" "$TESTS" --resume || rc=$?
    if [ "$rc" -eq 3 ]; then
        echo ""
        echo "  PUSH BLOCKED — another test sweep is already running (t1888)."
        echo "  The suites were NOT run: one sweep at a time is what keeps the box alive."
        echo "  Wait for it to finish, then push again."
        echo ""
        exit 1
    fi
    if [ "$rc" -ne 0 ]; then
        echo ""
        echo "  PUSH BLOCKED — a test suite failed that is not in the ceiling."
        echo ""
        echo "  Fix it, or -- if it genuinely belongs there -- add it to"
        echo "  workspace/test-failures-ceiling.json with the reason it is allowed."
        echo ""
        exit 1
    fi
else
    echo "pre-push: $TESTS not found. NOTHING was tested, and that is not a pass."
    exit 1
fi

exit 0
