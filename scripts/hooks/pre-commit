#!/bin/sh
#
# pre-commit — blocks the two things that are unrecoverable once committed.
#
# Installed by scripts/install-hooks.ps1. Git does not clone hooks, so every fresh
# clone must run that installer; check-workspace.ps1 reports when they are missing.
#
# This hook is deliberately fast and dependency-free (POSIX sh + git only) so that
# nobody is ever tempted to skip it for speed.

fail() {
    echo ""
    echo "  COMMIT BLOCKED — $1"
    echo ""
    shift
    for line in "$@"; do echo "  $line"; done
    echo ""
    echo "  If this is a false positive, fix the content rather than passing"
    echo "  --no-verify. See rule 10 in AGENTS.md."
    echo ""
    exit 1
}

landing_row() {
    # $1 = the gate that refused, $2 = red suite names, one per line (may be empty)
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    [ -n "$root" ] || return 0
    mkdir -p "$root/workspace" 2>/dev/null || return 0
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo detached)
    list=""
    for s in $2; do
        if [ -n "$list" ]; then list="$list, "; fi
        list="$list\"$s\""
    done
    jtask="null";   [ -n "${CODER_TASK:-}" ]      && jtask="\"$CODER_TASK\""
    jbrief="null";  [ -n "${CODER_BRIEF_SHA:-}" ] && jbrief="\"$CODER_BRIEF_SHA\""
    jtarget="null"; [ -n "${CODER_TARGET:-}" ]    && jtarget="\"$CODER_TARGET\""
    jops="${CODER_OPS_APPLIED:-null}"
    printf '{"ts": "%s", "task": %s, "brief_sha": %s, "ops_applied": %s, "target_suite": %s, "refusing_gate": "%s", "red_dep_suites": [%s], "ceiling_checked": true, "branch": "%s", "bypassed": false}\n' \
        "$ts" "$jtask" "$jbrief" "$jops" "$jtarget" "$1" "$list" "$branch" \
        >> "$root/workspace/landing-ledger.jsonl"
}


# --- 1. Secrets -------------------------------------------------------------------
# A live Anthropic key exists on this machine, outside the repo. It stays outside.
# Scanning the staged diff catches it wherever it came from, including a file that
# .gitignore does not happen to cover.

SECRETS='sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

# ONE KNOWN PLACEHOLDER (2026-10-13, chat/ into git): an explainer in the Claude export shows what a key
# looks like with an alphabet-run example -- an alphabet run, not a credential. It is
# stripped before matching, so the same line holding a REAL key still fails. Add nothing else here
# without the same proof (scripts/check_workspace.py SECRET_PLACEHOLDER holds the same string).
PLACEHOLDER='sk-ant-''ABCdefGH''123ijKLmnop456[A-Za-z0-9_-]*'   # split: this line must not be key-shaped
# Added lines first, then the pattern with no leading ".*" (2026-10-13): "^\+.*(...)" is quadratic on
# a long line, and chat/'s exports are 60 MB single lines -- it ran 11 minutes on one commit.
hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | sed -E "s/$PLACEHOLDER//g" | grep -nE "$SECRETS" | cut -c1-300 | head -5)
if [ -n "$hits" ]; then
    fail "a staged change contains something shaped like a credential." \
         "$hits" \
         "" \
         "The live key belongs at ~/.secrets/anthropic.env and nowhere else."
fi

# --- 2. Google-native stub files --------------------------------------------------
# These sync down from Drive unreadable while still reporting a plausible size, so a
# size check will not warn you. Committing one propagates a file nobody can open.
# See docs/LESSONS.md, L-005 and L-020.

stubs=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(gdoc|gsheet|gslides|gdraw|gform|gtable|glink)$')
if [ -n "$stubs" ]; then
    fail "Google-native stub files are staged." \
         "$stubs" \
         "" \
         "These are unreadable by every tool. Their presence means a write failed."
fi

# --- 3. Zero-byte markdown --------------------------------------------------------
# The signature of a write that silently failed, usually a Drive round trip.

for f in $(git diff --cached --name-only --diff-filter=A | grep '\.md$'); do
    if [ -f "$f" ] && [ ! -s "$f" ]; then
        fail "a zero-byte markdown file is staged: $f" \
             "An empty .md here almost always means a write failed rather than" \
             "that you meant to add an empty file."
    fi
done

# --- 4. chat/ only while nothing can push it ------------------------------------
# chat/ is the exported Claude history and the Family Project material. It is tracked since D-38
# (2026-10-13) BECAUSE the repository has no remote: the NAS bundle is the only place history goes.
# If a remote ever comes back, committing chat/ is refused again -- a push cannot be recalled.

chatfiles=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^chat/')
if [ -n "$chatfiles" ] && [ -n "$(git remote)" ]; then
    fail "a staged path is under chat/ and this repository has a remote ($(git remote | tr '\n' ' '))." \
         "$(echo "$chatfiles" | head -5)" \
         "" \
         "chat/ is personal material; D-38 tracks it only because nothing can push it." \
         "Remove the remote (git remote remove <name>) or unstage chat/."
fi

# --- 5. Anything under workspace/private/ -----------------------------------------
# The seeded-defect audit protocol. Its whole validity rests on the model under
# evaluation never having read it -- it names the defect classes, the sampling rule and
# the pass gate. Committing it puts a copy on a remote, and a leaked answer key cannot be
# un-leaked. See D-23.

privfiles=$(git diff --cached --name-only --diff-filter=ACMR \
            | grep -E '^workspace/private/' \
            | grep -v '^workspace/private/README\.md$')
if [ -n "$privfiles" ]; then
    fail "a staged path is under workspace/private/, which must never be committed." \
         "$(echo "$privfiles" | head -5)" \
         "" \
         "This is the audit protocol. It only works while the model being audited has" \
         "not read it, and a push cannot be recalled. See D-23."
fi

# --- 6. Defect signatures in Python -----------------------------------------------
# Two signatures destroy evidence needed to diagnose a model failure: the greedy
# extractor and a fixed-width slice stored into a record. A slice into print() or a
# log line is display, not a record, and must keep passing. The same distinction is
# drawn in scripts/harness_inventory.py.

pyfiles=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$')
if [ -n "$pyfiles" ]; then
    sigout=$(python3 "$(dirname "$0")/../signature_gate.py" $pyfiles 2>&1)
    sigrc=$?
    if [ $sigrc -ne 0 ]; then
        fail "a staged Python file contains a defect signature that destroys evidence." \
             "$sigout" \
             "" \
             "The greedy extractor and record-truncating slices make model failures" \
             "undiagnosable. Fix the code, do not pass --no-verify."
    fi
fi

# --- The script library (Jas, 2026-09-14: "Scripts can't run unless registered.") -----------
# A new or renamed .py/.sh cannot be committed unregistered, and a deleted one cannot leave a
# stale entry behind. The runtime guard stops an unregistered script RUNNING; this stops one
# being SHIPPED. Register with: python3 scripts/library.py register <path> "what it does"
libout=$(python3 "$(dirname "$0")/../library.py" verify --staged 2>&1)
if [ $? -ne 0 ]; then
    fail "a staged script is unregistered, or adds a defect a library check blocks." \
         "$libout" \
         "" \
         "A script that is not registered cannot run, so it must not be committed either."
fi

# --- library.json travels with the SCRIPTS.md it regenerates (2026-10-02) -----------------------
# `library.py register` rewrites both. Committing library.json alone left SCRIPTS.md dirty on main,
# and a dirty file the bridge also touches makes the freeze hold the branch for Claude: t502, t104
# and t395 all sat held that way the same day.
if git diff --cached --name-only | grep -qx 'scripts/library.json' \
   && git diff --name-only | grep -qx 'workspace/SCRIPTS.md'; then
    fail "scripts/library.json is staged but workspace/SCRIPTS.md, which it regenerates, is not." \
         "Stage it too: git add workspace/SCRIPTS.md"
fi

# --- Suites that judge the OTHER suites (2026-09-24) ------------------------------------------
# A suite marked `# META-SUITE` reads scripts/tests/ as its subject. Committing a new test can
# break it without touching it, and nothing ran it at commit: test_ask_q16_finish.py broke
# test_no_live_model_in_suites.py, and the first anyone knew was coder.py refusing a Gemma
# dispatch at baseline an hour later. They are fast, so they run whenever a test is staged.
if git diff --cached --name-only | grep -q '^scripts/tests/'; then
    for meta in $(grep -l '^# META-SUITE' "$(dirname "$0")/../tests/"*.py 2>/dev/null); do
        metaout=$(timeout 120 python3 "$meta" 2>&1)
        if [ $? -ne 0 ]; then
            fail "a staged test breaks $(basename "$meta"), which judges every suite." \
                 "$metaout" \
                 "" \
                 "Fix the staged test, or the meta-suite if its rule is wrong -- not --no-verify."
        fi
    done
fi

# --- The suites that use a staged script (t650b, Jas 2026-10-02) ------------------------------
# One red suite on main refuses EVERY coder build until someone notices (10-01: 17 refusals in
# two hours from three suites a commit made stale). Run the suites that import a staged script;
# a newly red one blocks. Known debt (test-failures-ceiling.json) is reported, not blocking.
# Only where the helper exists: test_precommit_record_sweep runs this hook in throwaway repos
# without it, and went red the moment this section landed (2026-10-02).
if [ -f "$(dirname "$0")/../related_tests.py" ] && git diff --cached --name-only | grep -qE '^(scripts|projects)/.*\.py$'; then
    # THE CAP COMES FROM JAS'S SETTING, THROUGH A FILE ITS OWN SUITE EXECUTES (2026-10-31, Claude's review).
    # 900 arrived in 1007505b9 with no derivation and is SMALLER than the work it bounds: related_tests.py caps each
    # SUITE at 300 s, so 300 x N passes 900 the moment a few suites are slow -- a cold gate over 97 suites needed over
    # twenty minutes on 2026-10-30 and this hook killed it, then printed "a staged script turns a suite that uses it
    # red" for a gate that had not finished. Jas wants the number adjustable from the Hub, so it is a setting; and the
    # suite asserts the VALUE rather than the text, because an earlier version asserted 'echo 1800' in this file while
    # the hook could not read the setting at all.
    . "$(dirname "$0")/../gate_cap.sh" "$(dirname "$0")/.."
    _gate_start=$(date +%s)
    relout=$(timeout "$GATE_CAP" python3 "$(dirname "$0")/../related_tests.py" 2>&1)
    rc=$?
    _gate_elapsed=$(( $(date +%s) - _gate_start ))
    # SAID, NOT SWALLOWED: `|| true` on this line once made a broken recorder look like a clean run.
    python3 "$(dirname "$0")/../gate_settings.py" record "$_gate_elapsed" "$rc" hook \
      || echo "  NOTE: the gate run was NOT recorded (${_gate_elapsed}s, rc ${rc})" >&2
    if [ "$rc" -ne 0 ]; then
        landing_row "t650b:related_tests" "$(printf '%s\n' "$relout" | sed -n 's/^  RED: //p')"
        if [ "$rc" -eq 124 ]; then
            # A GATE THAT DID NOT FINISH IS NOT A RED SUITE. Saying otherwise sent me round four close-outs looking
            # for a suite that was never red, with an EMPTY red list as the only clue.
            fail "the related-tests gate did not finish in ${GATE_CAP} s -- NO suite is called red (elapsed ${_gate_elapsed}s)." \
                 "$relout" \
                 "" \
                 "This is a TIMEOUT (rc 124), not a verdict. Run it by hand: python3 scripts/related_tests.py"
        else
            fail "a staged script turns a suite that uses it red -- every coder build would refuse." \
                 "$relout" \
                 "" \
                 "Fix the code or the suite. Rerun: python3 scripts/related_tests.py"
        fi
    fi
fi

# --- A deleted file a lesson names as its guard (2026-10-12) --------------------------------------
# related_tests sees only suites that IMPORT a staged script. Deleting test_reconcile_manifest.py
# (de348ecc) broke L-050's ENFORCEMENT line, which only check_enforcement reads -- main went red and
# 129 builds were held until db36c9ac restored it. A staged deletion now runs that check too.
if [ -f "$(dirname "$0")/../check_enforcement.py" ] && [ -n "$(git diff --cached --name-only --diff-filter=D)" ]; then
    enfout=$(timeout 120 python3 "$(dirname "$0")/../check_enforcement.py" 2>&1)
    if [ $? -ne 0 ]; then
        fail "a deleted file is still named as a lesson's ENFORCEMENT -- main would go red." \
             "$enfout" "" \
             "Re-home the lesson's guard first (docs/LESSONS.md), or keep the file."
    fi
fi

# --- Every build chunk belongs to a task (Jas, 2026-09-25) --------------------------------------
# 28 chunks had been enrolled with no TASK line; nothing stopped it. Enrolment is a commit to
# scripts/autonomy_loop.sh or a brief, so the check runs exactly then.
if git diff --cached --name-only | grep -qE '^(scripts/autonomy_loop\.sh|workspace/briefs/)'; then
    tout=$(timeout 60 python3 "$(dirname "$0")/../tests/test_every_chunk_has_task.py" 2>&1)
    if [ $? -ne 0 ]; then
        fail "an enrolled build chunk has no task." "$tout" "" \
             "Add 'TASK: tNNN' as the brief's first line (make the task if none fits)."
    fi
fi

# --- No call site invents its own sampling values (t216, 2026-09-30) ---------------------------
# DETECT -> REFUSE. test_sampling_single_source.py (L-135) found invented temperatures only when
# someone ran the suite; the file that sent them had long since shipped. It takes ~0.2 s, so it
# runs on every commit that stages Python and the literal never lands. (Not in settings.request():
# an override there is someone saying what they want, and the mistake it hunts is a call site
# that never goes through settings at all.)
if git diff --cached --name-only | grep -qE '\.py$'; then
    sout=$(timeout 60 python3 "$(dirname "$0")/../tests/test_sampling_single_source.py" 2>&1)
    if [ $? -ne 0 ]; then
        fail "a call site sets its own sampling values (temperature, top_p, ...)." \
             "$(echo "$sout" | grep -E '^FAIL' | tail -6)" "" \
             "Take them from settings.sampling() / settings.request() -- L-135."
    fi
fi

# --- No silent reassignment (Jas, 2026-10-19) -------------------------------------------------
# taskstore.set_meta writes "Reassigned <old> -> <new> by <code>: <why>" on every change of
# assignee; a hand edit of a task file's `assigned:` line skips it (t1309, sed, 2026-10-17). A staged
# task file whose assignee changed must add that note in the same commit.
if git diff --cached --name-only | grep -qE '^workspace/tasks/'; then
    rout=$(timeout 60 python3 "$(dirname "$0")/../check_reassignment_notes.py" 2>&1)
    if [ $? -ne 0 ]; then
        fail "a task was reassigned without the note saying who and why." "$rout"
    fi
fi

# --- A Hub page and its "how this page works" text (C3, 2026-10-26) -------------------------------
# Every page's ? opens hub_common.PAGES[key]. The text is data, and nothing verified it: on 2026-10-26
# grep page_help scripts/*.py returned nothing, so a page could change and its explanation rot in
# silence. The rule lives in check_workspace.page_help_problems -- ONE copy, called here with the
# staged list -- because a tree cannot say what a commit is about to contain.
# NO $? AFTER A PIPELINE (L-054, and check_workspace flags it): capture the status with `if !`, and
# feed the guard from a here-string so there is no pipe to lose a failure in.
if git diff --cached --name-only | grep -q '^projects/app-repo/'; then
    changed=$(git diff --cached --name-only)
    if ! ph=$(timeout 60 python3 "$(dirname "$0")/../check_workspace.py" --page-help-guard <<EOF
$changed
EOF
); then
        fail "a Hub page changed and its how-this-page-works text did not." "$ph"
    fi
fi

# --- The network map has ONE write path (N3, 2026-10-26) ---------------------------------------
# The chart's changelog has six rows that do not chain, because the chart was changed outside
# flow_change.py. The network map gets the same gate BEFORE it gets a page, so the page is never the
# easiest way to change it. The rule lives in network_change.py's guard -- one copy, called here.
if git diff --cached --name-only | grep -q '^workspace/network\.json$'; then
    if ! nw=$(timeout 60 python3 "$(dirname "$0")/../network_change.py" guard 2>&1); then
        fail "workspace/network.json was changed outside scripts/network_change.py." "$nw"
    fi
fi

# --- FLOW.json is written by flow_change.py, and nothing else (C1, 2026-10-26) --------------------
# "Nothing on the Flow chart is edited except through these commands" was a sentence in flow_change.py's
# docstring and `grep -rl FLOW.json scripts/hooks/` found no hook at all; six of the changelog's rows do
# not chain, so the file was changed behind the function at least six times. The rule lives in
# flow_change.guard -- one copy, called here with no pipe and no $? (L-054).
if git diff --cached --name-only | grep -q 'projects/local-inference/models/FLOW\.json$'; then
    if ! fg=$(timeout 60 python3 "$(dirname "$0")/../flow_change.py" guard 2>&1); then
        fail "FLOW.json was changed outside flow_change.py." "$fg"
    fi
fi

# --- mf4: a state path cannot be renamed without a migration ------------------------------------
# Seen: the scoping-queue rename moved the code but not the live directory. The rule lives in
# scripts/state_path_gate.py -- one copy: a staged change that removes a workspace/run-logs/ or
# ~/.cache/workspace/ path literal, while the OLD path has writes in the last 24h, is refused
# unless the branch stages a migration script or a test that starts from the old layout.
if [ -f "$(dirname "$0")/../state_path_gate.py" ]; then
    if ! spout=$(timeout 60 python3 "$(dirname "$0")/../state_path_gate.py" --staged 2>&1); then
        fail "a live state path is renamed with no migration (state_path_gate, mf4)." "$spout"
    fi
fi

exit 0
